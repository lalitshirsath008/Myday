# `npm run dev` defaults to the clearly-labelled in-browser DEMO backend with fictional test data.
# To develop against the Firebase emulators instead, create web/.env.development.local with:
#   VITE_BACKEND=firebase
#   VITE_USE_EMULATORS=true
#   VITE_FIREBASE_PROJECT_ID=demo-rgk-worktrack
#   VITE_FIREBASE_API_KEY=demo-key
VITE_BACKEND=demo
