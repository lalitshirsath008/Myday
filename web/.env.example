# Copy to web/.env.production.local (production) or web/.env.local (local Firebase) and fill in.
# These are the PUBLIC Firebase web-app settings from Firebase Console → Project settings → Your apps.
# They identify the project; access is protected by Auth + the server-side API, not by hiding these.

# "firebase" (real backend) or "demo" (in-browser test data, clearly labelled, never for production)
VITE_BACKEND=firebase

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Set to "true" to talk to the local Firebase emulators (auth :9099, functions :5001)
VITE_USE_EMULATORS=false
