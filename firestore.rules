rules_version = '2';

// RGK WorkTrack — Firestore Security Rules
//
// Design decision (docs/ARCHITECTURE.md §Security): the web app never reads or writes Firestore
// directly. Every operation goes through the `api` Cloud Function, which verifies the caller's
// Firebase ID token, loads their role and account status server-side, and enforces role and
// reporting-scope checks before touching data. The Admin SDK used by functions bypasses these rules.
//
// Denying all client access means a modified client, a stolen API key or a crafted request cannot
// read another employee's reports, escalate a role, or edit audit history.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
